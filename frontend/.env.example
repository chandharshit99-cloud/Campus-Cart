# ─── CampusCart Frontend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.

# Backend API URL (leave blank to use auto-detect: localhost dev / Render production)
# For local development this is usually not needed.
REACT_APP_API_URL=

# Razorpay public key ID (get from https://dashboard.razorpay.com)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
