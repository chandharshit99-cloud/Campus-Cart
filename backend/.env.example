# ─── CampusCart Backend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.

# Server port
PORT=3000

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=campuscart1

# JWT secret key (use a strong random string in production)
JWT_SECRET=change_this_to_a_strong_random_secret_in_production

# Allowed frontend origins — comma-separated for multiple (no spaces around commas)
# Example for Railway/Render deployment:
# CORS_ORIGIN=http://localhost:3001,https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:3001

# Razorpay keys (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
